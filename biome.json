{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"domains": {
			"project": "recommended",
			"types": "recommended"
		},
		"rules": {
			"suspicious": {
				"noImportCycles": "on"
			}
		}
	}
}
